{
  "manifest_version": 3,
  "name": "NEXUS DAILY — New Tab",
  "version": "0.5.0",
  "description": "Tu periódico personal con la marca de Radar.IA: portada editorial del radar en cada pestaña nueva, sin llamadas a modelos de IA.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://aievolve.netlify.app/*",
    "https://earnest-pie-01548d.netlify.app/*",
    "https://raw.githubusercontent.com/*"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
